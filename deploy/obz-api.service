[Unit]
Description=OBZ FastAPI Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/obz_project
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/obz_project/.env
ExecStart=/opt/obz_project/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8080 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
