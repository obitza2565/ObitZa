# ── Server ───────────────────────────────────────────────────────────────
PORT=4100
# Comma-separated list of allowed browser origins (no wildcard in production)
CORS_ORIGINS=https://obzexchange.com,https://www.obzexchange.com
# Number of trusted reverse-proxy hops when running behind nginx.
# Use a hop count (usually 1), never a blanket "trust all proxies" —
# otherwise clients can spoof X-Forwarded-For and bypass the rate limiter.
TRUST_PROXY_HOPS=1

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── Virtual mining economics ─────────────────────────────────────────────
# Fixed price: 1 OBZ = 1 USDT
OBZ_PRICE_USDT=1
# Global cap shared by every miner, per UTC day
DAILY_MINING_CAP_OBZ=100
# Default accrual rate per user while a session is active
DEFAULT_MINING_RATE_OBZ_PER_HOUR=0.5
# How often the accrual loop runs
TICK_INTERVAL_MS=1000

# ── Withdrawal approval ───────────────────────────────────────────────────
# Withdrawals above this USDT value are queued as PENDING for manual
# admin approval instead of being paid out automatically.
WITHDRAWAL_APPROVAL_THRESHOLD_USDT=50
# Shared secret required in the "x-admin-key" header for /api/admin/* routes
ADMIN_API_KEY=

# ── Hot wallet (BNB Chain payouts) ───────────────────────────────────────
# Public RPC endpoint only — never point this at a node run on this server
BSC_RPC_URL=https://bsc-dataseed.binance.org/
# ERC-20 OBZ token contract address deployed on BNB Chain
OBZ_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
OBZ_TOKEN_DECIMALS=18
# Hot wallet private key used to sign payout transactions.
# NEVER commit this value. Store it only in this untracked .env file
# or in your host's secret manager.
HOT_WALLET_PRIVATE_KEY=

# ── Hot wallet balance alerts ─────────────────────────────────────────────
# Alert threshold for native gas token (BNB) balance
MIN_BNB_GAS_BALANCE=0.02
# Alert threshold for the hot wallet's OBZ token balance
MIN_OBZ_HOT_WALLET_BALANCE=100
# How often to check balances, in milliseconds
BALANCE_CHECK_INTERVAL_MS=300000
# Discord/Slack-compatible webhook URL for low-balance notifications
ALERT_WEBHOOK_URL=

# ── Telegram notifications ─────────────────────────────────────────────────
# 1) Message @BotFather on Telegram -> /newbot -> copy the token here
# 2) Message @userinfobot (or add the bot to your group and read updates)
#    to find your chat ID
# 3) IMPORTANT: Message your bot first (/start) before it can reply to you
#
# Bot commands (message these to your bot):
#   /balance - ดูยอดเงิน Hot Wallet และสถานะ Pool
#   /pending - ดูคำขอถอนที่รออนุมัติ
#   /status  - สถานะระบบทั้งหมด
#   /help    - แสดงคำสั่งทั้งหมด
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

